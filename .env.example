# ==========================================================================
# Ocean Intelligence Platform - environment template
#
# Copy to .env and fill in. NEVER commit .env.
# Every value below is a placeholder; no real credential belongs in this file.
# ==========================================================================

# ── Application ───────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# console | json  (use json in production so logs are parseable)
LOG_FORMAT=console

# ── Demo mode ─────────────────────────────────────────────────────────────
# true  -> synthetic satellite data, clearly tagged SIMULATED in every response
# false -> real providers only; endpoints report unavailable without credentials
DEMO_MODE=true

# ── Database ──────────────────────────────────────────────────────────────
# SQLite default needs no server. For Postgres:
#   DATABASE_URL=postgresql+psycopg://oip:CHANGEME@localhost:5432/oip
DATABASE_URL=sqlite:///./data/oip.db
DB_ECHO=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins. Never use "*" with credentials enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── India water intelligence ──────────────────────────────────────────────
# Comma-separated state codes to ingest from CPCB (National Water Data Portal)
# at start-up when the water tables are empty, e.g. MH,DL,KA. Blank disables
# it; use `python -m app.water.cli ingest --states MH` instead. The source is
# public and needs no key.
WATER_BOOTSTRAP_STATES=

# ── Google Earth Engine ───────────────────────────────────────────────────
# Set GEE_ENABLED=true and provide all three to use real Sentinel-1 data.
# GOOGLE_APPLICATION_CREDENTIALS must be a path to a service-account JSON key
# that lives OUTSIDE the repository and is never uploaded to a notebook.
GEE_ENABLED=false
GEE_PROJECT_ID=your-gcp-project-id
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/gee-key.json

# ── Vision ────────────────────────────────────────────────────────────────
# yolo | mock
#
# The YOLO backend needs `pip install ultralytics` (which pulls torch) and a
# checkpoint. This project's best.pt is a YOLOv8 detector trained on
# pollution.yaml for 100 epochs at 640 px (ultralytics 8.4.41, 2026-04-22).
#
# Its four classes, read from the checkpoint itself, are:
#   0 oil_spill   1 algae_bloom   2 plastic_waste   3 chemical_pollution
# NOTE: the original notebook listed class 3 as "marine_debris", which was
# wrong. The detector now reads names from the file, so a retrained model
# with different classes needs no code change.
#
# LICENCE: Ultralytics YOLOv8 is AGPL-3.0. Serving it over a network obliges
# you to release your source under AGPL unless you hold a commercial licence
# from Ultralytics. Relevant only if this is deployed publicly.
DETECTOR_BACKEND=mock
YOLO_MODEL_PATH=/absolute/path/to/best.pt
DETECTION_CONFIDENCE_THRESHOLD=0.25

# ── SAR dark-formation detection ──────────────────────────────────────────
# Backscatter (dB) below which a cell is a candidate dark formation.
SAR_DARK_THRESHOLD_DB=-22.0
SAR_MIN_WIND_SPEED_MS=3.0

# ── Ingestion ─────────────────────────────────────────────────────────────
INGEST_LOOKBACK_DAYS=10
INGEST_SCALE_M=500

# ── LLM (Phase 2: RAG and agents) ─────────────────────────────────────────
# none | gemini | openai | anthropic
LLM_PROVIDER=none
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================================================
# NOT USED BY THIS PLATFORM - listed so nobody re-adds it
#
# NGROK_AUTH_TOKEN: the original notebook hardcoded a live ngrok token in a
# shared file. The platform now runs a normal server; if you tunnel for a
# demo, export the token in your shell, never in code or a notebook cell.
# ==========================================================================
