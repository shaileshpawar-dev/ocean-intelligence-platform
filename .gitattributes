# Normalise line endings: LF in the repository, native in the working tree.
# Without this, a Windows checkout commits CRLF and every cross-platform diff
# is noise.
* text=auto eol=lf

# Shell scripts and Dockerfiles must keep LF even on Windows checkouts, or the
# container refuses to run them.
*.sh   text eol=lf
Dockerfile*  text eol=lf

# Binary assets: never touch.
*.png  binary
*.jpg  binary
*.ico  binary
*.pt   binary
*.onnx binary
